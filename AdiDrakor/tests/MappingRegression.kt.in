package PACKAGE

import kotlinx.coroutines.*
import org.json.JSONObject
import com.lagradost.cloudstream3.PlaybackApiFixture
import com.lagradost.cloudstream3.utils.ExtractorLink
import com.lagradost.cloudstream3.SubtitleFile
import com.sun.net.httpserver.HttpServer
import java.net.InetSocketAddress
import okhttp3.*
import okhttp3.MediaType.Companion.toMediaType
import okhttp3.ResponseBody.Companion.toResponseBody

fun main() = runBlocking {
    var count = 0
    suspend fun test(name: String, block: suspend () -> Unit) { block();count++;println("PASS $name") }
    val r = MATCHER.Request(listOf("Example", "Judul Asli"),2022,1,null,null)
    val movie = MATCHER.Subject("123","Example",2022,1)
    fun raw(s: MATCHER.Subject) = JSONObject().put("subjectId",s.id).put("title",s.title)
        .put("releaseDate","${s.year}-01-01").put("subjectType",s.type)
    fun search(s: MATCHER.Subject = movie) = """{"code":0,"data":{"results":[{"subjects":[${raw(s)}]}]}}"""
    fun detail(s: MATCHER.Subject = movie) = """{"code":0,"data":${raw(s)}}"""
    val seasons = """{"code":0,"data":{"seasons":[{"se":1,"maxEp":8},{"se":2,"maxEp":6}]}}"""
    test("movie mapping considers all search results") {
        check(MATCHER.choose(r,listOf(movie.copy(id="1",year=1999),movie)).subject == movie)
    }
    test("original and alternative TMDB titles") {
        check(MATCHER.choose(r,listOf(movie.copy(title="Judul Asli"))).subject != null)
    }
    test("normalization retains non-Latin titles and accents") {
        check(MATCHER.normalize("Éxample: 2") == "example 2")
        check(MATCHER.normalize("한국어") != "")
    }
    test("wrong year and missing year rejected") {
        check(MATCHER.choose(r,listOf(movie.copy(year=2021))).subject == null)
        check(MATCHER.choose(r.copy(year=null),listOf(movie)).subject == null)
        check(MATCHER.choose(r,listOf(movie.copy(year=null))).subject == null)
    }
    test("movie and TV with identical title remain separate") {
        check(MATCHER.choose(r,listOf(movie.copy(type=2))).subject == null)
        check(MATCHER.choose(r.copy(type=2,season=1,episode=1),listOf(movie.copy(type=2))).subject != null)
    }
    test("ambiguous IDs rejected and repeated same ID deduplicated") {
        check(MATCHER.choose(r,listOf(movie,movie.copy(id="124"))).reason == "AMBIGUOUS_SUBJECT")
        check(MATCHER.choose(r,listOf(movie,movie)).subject == movie)
    }
    test("similar title is not an exact alias") {
        check(MATCHER.choose(r,listOf(movie.copy(title="Example Returns"))).subject == null)
    }
    test("Moviebox TV season-range suffix is display metadata only") {
        val tv=r.copy(type=2,season=2,episode=4)
        check(MATCHER.matches(tv,movie.copy(type=2,title="Example S1-S3")))
        check(!MATCHER.matches(tv,movie.copy(type=2,title="Example S3-S4")))
        check(!MATCHER.matches(r,movie.copy(title="Example S1-S3")))
    }
    test("subject not found") { check(MATCHER.choose(r,emptyList()).subject == null) }
    test("season and episode must exist exactly") {
        check(MATCHER.episode(seasons,"123",1,1))
        check(MATCHER.episode(seasons,"123",2,6))
        check(!MATCHER.episode(seasons,"123",2,7))
        check(!MATCHER.episode(seasons,"123",3,1))
        check(!MATCHER.episode(seasons,"123",1,0))
    }
    test("server season metadata identity and error checks") {
        check(!MATCHER.episode(seasons.replace("\"seasons\":","\"subjectId\":\"124\",\"seasons\":"),"123",1,1))
        check(!MATCHER.episode(seasons.replace("\"code\":0","\"code\":401"),"123",1,1))
    }
    test("detail identity is verified after search") {
        val got=MATCHER.resolve(r,{search()},{detail(movie.copy(id="124"))},{seasons})
        check(got.reason == "SUBJECT_DETAIL_IDENTITY_MISMATCH")
    }
    test("movie does not request season-info") {
        val got=MATCHER.resolve(r,{search()},{detail()},{error("Movie season request")})
        check(got.subject == movie)
    }
    test("TV validates requested 2/4 without remapping") {
        val tv=movie.copy(type=2)
        val got=MATCHER.resolve(r.copy(type=2,season=2,episode=4),{search(tv)},{detail(tv)},{seasons})
        check(got.subject == tv)
        check(MATCHER.resolve(r.copy(type=2,season=9,episode=4),{search(tv)},{detail(tv)},{seasons}).reason == "EPISODE_NOT_AVAILABLE")
    }
    test("API failure and malformed response return diagnostics") {
        check(MATCHER.resolve(r,{null},{detail()},{seasons}).reason == "SEARCH_API_FAILED")
        check(MATCHER.resolve(r,{"invalid"},{detail()},{seasons}).reason == "SEARCH_API_INVALID")
        check(MATCHER.resolve(r,{"{\"code\":401}"},{detail()},{seasons}).reason == "SEARCH_API_REJECTED")
    }
    test("cancellation propagates") {
        try { MATCHER.resolve(r,{throw CancellationException("fixture")},{detail()},{seasons});error("lost cancellation") }
        catch (_: CancellationException) {}
    }
    test("timeout cancels pending mapping IO") {
        check(withTimeoutOrNull(30) { MATCHER.resolve(r,{delay(1000);search()},{detail()},{seasons}) } == null)
    }
    test("missing TV indices rejected") {
        check(!MATCHER.valid(r.copy(type=2)))
        check(!MATCHER.valid(r.copy(type=2,season=1,episode=0)))
    }

    val fixture=JSONObject(java.io.File(System.getProperty("migration.fixtures"),"insidious-public-detail.json").readText())
    val insidious=fixture.getJSONObject("data")
    val insidiousRequest=MATCHER.Request(listOf("Insidious: Out of the Further"),2026,1,null,null)
    val originalId=insidious.getString("subjectId")
    val dubId=insidious.getJSONArray("dubs").getJSONObject(1).getString("subjectId")
    val original= MATCHER.subject(insidious)!!
    fun catalog(vararg items: JSONObject)=JSONObject().put("code",0).put("data",JSONObject()
        .put("results",org.json.JSONArray().put(JSONObject().put("subjects",org.json.JSONArray(items.toList()))))).toString()
    fun envelope(item: JSONObject)=JSONObject().put("code",0).put("data",item).toString()
    test("observed Insidious public metadata decodes original plus seven explicit dubs") {
        val html=java.io.File(System.getProperty("migration.fixtures"),"insidious-public-nuxt.html").readText()
        val parsed=MATCHER.catalogPage(html).single()
        check(parsed.getString("subjectId")==originalId)
        check(parsed.getString("detailPath")=="insidious-out-of-the-further-06560hmGCP9")
        check(parsed.getJSONArray("dubs").length()==8)
        check(MATCHER.parseSearch(MATCHER.catalogSearch(html)).single()==original)
        check(MATCHER.catalogPage("<html>error</html>").isEmpty())
    }
    test("Insidious sparse mobile search verifies year and kind from same-ID detail") {
        val sparse=JSONObject().put("subjectId",originalId).put("title",original.title)
        check(MATCHER.resolve(insidiousRequest,{catalog(sparse)},{envelope(insidious)},{error("movie season")}).subject==original)
    }
    test("same film dub subjects collapse only to server-declared original") {
        val dub=JSONObject(insidious.toString()).put("subjectId",dubId)
        val result=MATCHER.resolve(insidiousRequest,{catalog(insidious,dub)},
            { envelope(if(it==originalId) insidious else dub) },{null})
        check(result.subject==original && result.metadata?.getString("detailPath")==insidious.getString("detailPath"))
    }
    test("dub-only search resolves declared original through separately verified detail") {
        val dub=JSONObject(insidious.toString()).put("subjectId",dubId)
        check(MATCHER.resolve(insidiousRequest,{catalog(dub)},
            { envelope(if(it==originalId) insidious else dub) },{null}).subject==original)
    }
    test("unrelated same-title subjects remain ambiguous despite explicit original family") {
        val separate=JSONObject(insidious.toString()).put("subjectId","999").apply { remove("dubs") }
        check(MATCHER.resolve(insidiousRequest,{catalog(insidious,separate)},
            { envelope(if(it==originalId) insidious else separate) },{null}).reason=="AMBIGUOUS_SUBJECT")
    }
    test("failed optional alias does not discard a verified main-title match") {
        val req=insidiousRequest.copy(titles=insidiousRequest.titles+"Unavailable Alias")
        check(MATCHER.resolve(req,{if(it=="Unavailable Alias") null else catalog(insidious)},
            {envelope(insidious)},{null}).subject==original)
    }
    test("detail year mismatch is never cured by sparse search or dub relation") {
        val wrong=JSONObject(insidious.toString()).put("releaseDate","2025-01-01")
        check(MATCHER.resolve(insidiousRequest,{catalog(insidious)},{envelope(wrong)},{null}).subject==null)
    }
    test("public original ISO language preserves Korean audio and does not relabel a dub") {
        val original=JSONObject(insidious.toString())
        original.getJSONArray("dubs").getJSONObject(0).put("lanCode","ko")
        val normalized=MATCHER.playbackMetadata(original)
        check(PLAYBACK.audioLanguages(normalized).first()=="ko")
        check(!original.has("lanName"))
        val raw="""{"code":0,"data":{"streams":[{"url":"https://cdn.example.test/original.mp4","lanName":"Korean"}]}}"""
        val streams=PLAYBACK.parse(raw,"H5",originalId,0,0,"",PLAYBACK.audioLanguages(normalized).first())
        check(streams.single().category==PLAYBACK.AudioCategory.ORIGINAL)
        check(!MATCHER.playbackMetadata(JSONObject(original.toString()).put("subjectId",dubId)).has("lanName"))
    }
    val target=r.copy(tmdbId="10",imdbId="tt1234567",works=listOf(MATCHER.Work("10","")))
    fun item(s: MATCHER.Subject=movie)=raw(s)
    test("sparse public metadata preserves native cast and full synopsis") {
        val native=JSONObject().put("staffList",org.json.JSONArray().put(JSONObject().put("name","Actor A")))
            .put("description","Full authoritative movie synopsis")
        val web=JSONObject().put("staffList",org.json.JSONArray()).put("description","")
        val merged=MATCHER.mergeMetadata(native,web)
        check(merged.getJSONArray("staffList").length()==1)
        check(merged.getString("description")==native.getString("description"))
    }
    test("conflicting discovery IDs are never silently overwritten") {
        val merged=MATCHER.mergeMetadata(JSONObject().put("tmdbId","10"),JSONObject().put("tmdbId","11"))
        check(MATCHER.identity(target,merged)=="EXTERNAL_ID_CONFLICT")
        check(MATCHER.identity(target,MATCHER.mergeMetadata(item().put("tmdbId",0),JSONObject().put("tmdbId","10")))=="EXTERNAL_ID_MATCH")
    }
    val translated=JSONObject("""{"id":10,"title":"Moon Sailor","original_title":"Moon Sailor","release_date":"2022-01-01",
      "translations":{"translations":[
        {"iso_639_1":"id","data":{"title":"Pelaut di Bulan","overview":"Kapten Nadia menemukan pemancar purba tersembunyi dekat kawah bulan sambil menyelamatkan teknisi Arman dari stasiun orbital rusak"}},
        {"iso_639_1":"en","data":{"title":"Moon Sailor","overview":"Captain Nadia discovers ancient signals beneath lunar craters while rescuing engineer Arman aboard damaged orbital station"}},
        {"iso_639_1":"fr","data":{"title":"Un autre titre"}}]},
      "credits":{"cast":[{"name":"Actor A"},{"name":"Actor B"}]}}""")
    val bilingual=MATCHER.hydrate(target.copy(titles=listOf("Moon Sailor")),translated)
    test("same-ID official Indonesian and English translations become prioritized queries") {
        check("Pelaut di Bulan" in bilingual.titles && "Moon Sailor" in bilingual.titles)
        check("Un autre titre" !in bilingual.titles)
        check(MATCHER.queries(bilingual).indexOf("Pelaut di Bulan") in 0..2)
    }
    test("wrong TMDB translation owner cannot inject titles synopsis or cast") {
        check(MATCHER.hydrate(target,JSONObject(translated.toString()).put("id",11))==target)
        check(MATCHER.hydrate(target.copy(tmdbId=null),translated).titles==target.titles)
    }
    test("localized synopsis proves identity without combining two weak translations") {
        val local=item().put("title","Pelaut di Bulan").put("description",bilingual.localizedOverviews.first())
        check(MATCHER.identity(bilingual,local)=="PLOT_MATCH")
        check(MATCHER.resolve(bilingual,{catalog(local)},{envelope(local)},{null}).subject?.title=="Pelaut di Bulan")
        val weak=bilingual.copy(overview="one short clue",localizedOverviews=listOf("another short clue"),castNames=emptyList())
        check(MATCHER.identity(weak,item().put("title","Pelaut di Bulan").put("description","one short clue another short clue")) !in setOf("PLOT_MATCH","CAST_MATCH"))
    }
    test("Indonesian function words cannot turn unrelated synopsis into identity proof") {
        val common="dan yang dari untuk dengan adalah mereka sebuah seorang pada dalam ketika saat setelah sebelum oleh akan telah sudah harus juga namun tetapi hingga atau menjadi karena agar tentang lebih sebagai sangat para kembali hidup dunia kota keluarga teman kisah"
        val req=bilingual.copy(overview=null,localizedOverviews=listOf("$common kapten menyelamatkan teknisi bulan"),castNames=emptyList())
        check(MATCHER.identity(req,item().put("title","Pelaut di Bulan").put("description","$common penyanyi merawat biola pedesaan")) !in setOf("PLOT_MATCH","CAST_MATCH"))
    }
    test("shared translated title with unrelated work or conflicting ID cannot reach selection") {
        val wrong=item().put("title","Pelaut di Bulan").put("description","Unrelated romance at a summer festival")
        check(MATCHER.resolve(bilingual,{catalog(wrong)},{envelope(wrong)},{null}).subject==null)
        wrong.put("tmdbId","11").put("staffList",org.json.JSONArray().put(JSONObject().put("name","Actor A")).put(JSONObject().put("name","Actor B")))
        check(MATCHER.resolve(bilingual,{catalog(wrong)},{envelope(wrong)},{null}).reason=="EXTERNAL_ID_CONFLICT")
    }
    test("Indonesian search miss can recover official English title without wrong-franchise fallback") {
        val req=bilingual.copy(titles=listOf("Pelaut di Bulan","Moon Sailor"))
        val english=item().put("title","Moon Sailor").put("tmdbId","10")
        val seen=mutableListOf<String>()
        val wrong=item(movie.copy(id="124")).put("title","Moon Sailor Returns").put("tmdbId","11")
        val got=MATCHER.resolve(req,{q -> seen+=q;if(q=="Moon Sailor") catalog(english) else catalog(wrong)},
            { id -> envelope(if(id=="123") english else wrong) },{null})
        check(got.subject?.title=="Moon Sailor" && seen==listOf("Pelaut di Bulan","Moon Sailor"))
    }
    test("official local aliases stay inside request budget even with many other countries") {
        val many=bilingual.copy(titles=listOf("Moon Sailor","Original Title")+(1..30).map { "Long distinctive other country alias $it" })
        check("Pelaut di Bulan" in MATCHER.queries(many).take(4))
        check(MATCHER.queries(many).size<=12)
    }
    test("localized cast proof still rejects wrong year media type and requested episode") {
        val local=item().put("title","Pelaut di Bulan").put("staffList",org.json.JSONArray().put(JSONObject().put("name","Actor A")).put(JSONObject().put("name","Actor B")))
        check(MATCHER.resolve(bilingual,{catalog(local)},{envelope(JSONObject(local.toString()).put("releaseDate","1999-01-01"))},{null}).subject==null)
        check(MATCHER.resolve(bilingual,{catalog(JSONObject(local.toString()).put("subjectType",2))},{envelope(local)},{null}).subject==null)
        val tv=JSONObject(local.toString()).put("subjectType",2)
        check(MATCHER.resolve(bilingual.copy(type=2,season=9,episode=4),{catalog(tv)},{envelope(tv)},{seasons}).reason=="EPISODE_NOT_AVAILABLE")
    }
    test("live Spider-Man metadata keeps actual distinct TMDB and Moviebox synopsis and verifies owning cast") {
        val tmdb=JSONObject(java.io.File(System.getProperty("migration.fixtures"),"spiderman-tmdb-bilingual.json").readText())
        val public=MATCHER.catalogPage(java.io.File(System.getProperty("migration.fixtures"),"spiderman-public-stars-nuxt.html").readText()).single()
        val req=MATCHER.hydrate(MATCHER.Request(listOf("Spider-Man: Brand New Day"),2026,1,null,null,tmdbId="969681"),tmdb)
        check(req.overview!=public.getString("description"))
        check("Spider-Man: Hari Baru" !in req.titles) // TMDB supplies no such title: never invent one.
        check(MATCHER.identity(req,public)=="CAST_MATCH")
        check(MATCHER.resolve(req,{catalog(public)},{envelope(public)},{null}).subject?.id=="6026412232966389904")
    }
    test("explicit external ID conflict rejects same title year") {
        check(MATCHER.identity(target,item().put("tmdbId","11"))=="EXTERNAL_ID_CONFLICT")
        check(MATCHER.identity(target,item().put("imdbId","tt7654321"))=="EXTERNAL_ID_CONFLICT")
        check(MATCHER.identity(target,item().put("tmdbId","10"))=="EXTERNAL_ID_MATCH")
        check(MATCHER.identity(target,item().put("tmdbId",0))=="TMDB_UNIQUE_WORK")
    }
    test("ambiguous TMDB same title year never selects another work by title alone") {
        val ambiguous=target.copy(works=listOf(MATCHER.Work("10",""),MATCHER.Work("11","")))
        check(MATCHER.identity(ambiguous,item())=="AMBIGUOUS_TMDB_WORK")
        check(MATCHER.resolve(ambiguous,{search()},{detail()},{null}).subject==null)
    }
    test("primary-title uniqueness never proves a colliding alternative title belongs to the same film") {
        val req=target.copy(titles=listOf("Example","Shared Alternative"))
        check(MATCHER.identity(req,item().put("title","Shared Alternative"))=="AMBIGUOUS_TMDB_WORK")
        check(MATCHER.identity(req,item().put("title","Shared Alternative").put("tmdbId","10"))=="EXTERNAL_ID_MATCH")
    }
    test("TMDB identity lookup failure fails closed without corroboration") {
        check(MATCHER.identity(target.copy(works=null),item())=="TMDB_IDENTITY_UNVERIFIED")
    }
    test("plot fingerprint disambiguates two works and rejects the other story") {
        val correct="astronaut Nora discovers ancient signals beneath frozen Europa while rescuing missing engineer Malik aboard damaged orbital station"
        val other="musician Elena travels rural villages restoring broken violins alongside retired teacher David during summer festival"
        val request=target.copy(overview=correct,works=listOf(MATCHER.Work("10",correct),MATCHER.Work("11",other)))
        check(MATCHER.identity(request,item().put("description",correct))=="PLOT_MATCH")
        check(MATCHER.identity(request,item().put("description",other))=="AMBIGUOUS_TMDB_WORK")
    }
    test("conflicting external ID beats matching synopsis and cast") {
        val meta=item().put("imdbId","tt7654321").put("description","same synopsis")
            .put("staffList",org.json.JSONArray().put(JSONObject().put("name","Actor A")).put(JSONObject().put("name","Actor B")))
        check(MATCHER.identity(target.copy(castNames=listOf("Actor A","Actor B")),meta)=="EXTERNAL_ID_CONFLICT")
    }
    test("validated primary source skips slow unused aliases") {
        var calls=0
        val got=MATCHER.resolve(r,{q -> calls++;check(q=="Example");search()},{detail()},{null})
        check(got.subject==movie && calls==1)
        var retries=0
        val recovered=MATCHER.resolve(r,{search()},{retries++;if(retries==1) null else detail()},{null})
        check(recovered.subject==movie && retries==2)
        var failures=0
        check(MATCHER.resolve(r.copy(titles=listOf("Example","Alias One","Alias Two")),
            {search()},{failures++;null},{null}).subject==null)
        check(failures==2)
    }
    test("discovery queries broaden punctuation and franchise only; selected title stays exact") {
        val q=insidiousRequest.copy(titles=listOf("Spider-Man: Brand New Day"))
        check(MATCHER.queries(q).contains("spider man brand new day"))
        check(MATCHER.queries(q).contains("Spider-Man"))
        check(!MATCHER.matches(q,movie.copy(title="Spider-Man 3",year=2026)))
        check(MATCHER.matches(q,movie.copy(title="Spiderman Brand New Day",year=2026)))
    }
    test("incorrect detail candidate does not hide independently verified correct subject") {
        val wrong=movie.copy(id="124")
        val both=catalog(raw(wrong),raw(movie))
        val got=MATCHER.resolve(r,{both},{id -> if(id=="123") detail() else detail(wrong.copy(year=1999))},{null})
        check(got.subject==movie)
    }
    test("release-year discrepancy requires exact external identity") {
        val meta=item(movie.copy(year=2021)).put("tmdbId","10")
        check(MATCHER.resolve(target,{search(movie.copy(year=2021))},{envelope(meta)},{null}).subject?.id=="123")
        check(MATCHER.resolve(target,{search(movie.copy(year=2021))},{detail(movie.copy(year=2021))},{null}).subject==null)
    }
    test("TMDB response parsing preserves two distinct same-title same-year works") {
        val result=MATCHER.tmdbWorks("""{"results":[{"id":10,"title":"Example","release_date":"2022-01-01"},{"id":11,"title":"Example","release_date":"2022-04-01"},{"id":12,"title":"Example","release_date":"1999-01-01"}]}""",target)
        check(result?.map { it.id }==listOf("10","11"))
        check(MATCHER.tmdbWorks("{}",target)==null)
        check(MATCHER.tmdbWorks("""{"total_pages":2,"results":[{"id":10,"title":"Example","release_date":"2022-01-01"}]}""",target)==null)
    }
    test("observed Spider-Man metadata maps to the selected TMDB work without switching film") {
        val meta=JSONObject(java.io.File(System.getProperty("migration.fixtures"),"spiderman-public-detail.json").readText()).getJSONObject("data")
        val req=MATCHER.Request(listOf("Spider-Man: Brand New Day"),2026,1,null,null,
            tmdbId="969681",overview=meta.getString("description"),works=listOf(MATCHER.Work("969681","")))
        val observed=MATCHER.subject(meta)!!
        val got=MATCHER.resolve(req,{catalog(meta)},{envelope(meta)},{null})
        check(got.subject==observed && observed.id=="6026412232966389904")
        check(got.metadata?.getString("detailPath")=="spider-man-brand-new-day-Aea8ARY1bb7")
    }

    test("invalid Nuxt reference graph and script text are never executed") {
        check(MATCHER.catalogPage("<script id=__NUXT_DATA__ type=application/json>[{\"subjectId\":0,\"title\":0}]</script>").isEmpty())
        check(MATCHER.catalogPage("<script>throw new Error('no')</script>").isEmpty())
    }

    val hotd=JSONObject(java.io.File(System.getProperty("migration.fixtures"),"hotd-public-detail.json").readText()).getJSONObject("data")
    val hotdOther=JSONObject(java.io.File(System.getProperty("migration.fixtures"),"hotd-edition-public-detail.json").readText()).getJSONObject("data")
    val hotdRequest=MATCHER.Request(listOf("House of the Dragon"),2022,2,1,1,tmdbId="94997",
        overview=hotd.getString("description"),castNames=listOf("Matt Smith","Emma D'Arcy","Olivia Cooke"))
    test("public detail binds season resource and stars to owning subject only") {
        val decoded=MATCHER.catalogPage(java.io.File(System.getProperty("migration.fixtures"),"hotd-public-nuxt.html").readText()).single()
        check(decoded.getString("subjectId")==hotd.getString("subjectId"))
        check(decoded.getJSONArray("staffList").length()>2)
        check(decoded.getJSONArray("catalogSeasons").getJSONObject(0).getInt("maxEp")==10)
        check(!MATCHER.catalogPage(java.io.File(System.getProperty("migration.fixtures"),"spiderman-public-nuxt.html").readText()).single().has("catalogSeasons"))
    }
    test("House of the Dragon S1E1 and S2E4 survive unavailable mobile season-info") {
        for(req in listOf(hotdRequest,hotdRequest.copy(season=2,episode=4))) {
            val got=MATCHER.resolve(req,{catalog(hotd)},{envelope(hotd)},{null})
            check(got.subject?.id==hotd.getString("subjectId"))
        }
        check(MATCHER.resolve(hotdRequest.copy(season=2,episode=9),{catalog(hotd)},{envelope(hotd)},{null}).subject==null)
        check(MATCHER.resolve(hotdRequest.copy(season=4,episode=1),{catalog(hotd)},{envelope(hotd)},{null}).subject==null)
    }
    test("explicit mobile episode negative overrides public range; missing range never guessed") {
        check(MATCHER.episodeStatus("""{"code":0,"data":{"seasons":[{"se":1,"maxEp":0}]}}""",hotd,hotd.getString("subjectId"),1,1)=="EPISODE_NOT_AVAILABLE")
        check(MATCHER.episodeStatus(null,JSONObject(hotd.toString()).apply {remove("catalogSeasons")},hotd.getString("subjectId"),1,1)=="SEASON_NOT_VERIFIED")
        check(MATCHER.episodeStatus(null,hotd,"999",1,1)=="SEASON_NOT_VERIFIED")
    }
    test("two independently verified same-work editions may recover playback without conflating unrelated works") {
        val got=MATCHER.resolve(hotdRequest,{catalog(hotd,hotdOther)},
            {envelope(if(it==hotd.getString("subjectId")) hotd else hotdOther)},{null})
        check(got.editions.size==2)
        val unrelated=JSONObject(hotdOther.toString()).put("description","unrelated story").put("staffList",org.json.JSONArray()).put("tmdbId","999")
        val safe=MATCHER.resolve(hotdRequest,{catalog(hotd,unrelated)},
            {envelope(if(it==hotd.getString("subjectId")) hotd else unrelated)},{null})
        check(safe.editions.size==1 && safe.subject?.id==hotd.getString("subjectId"))
    }
    test("yearless selected work requires external ID or independent detail proof") {
        val noYear=target.copy(year=null,works=null)
        check(MATCHER.valid(noYear))
        check(MATCHER.resolve(noYear,{search()},{envelope(item().put("tmdbId","10"))},{null}).subject==movie)
        check(MATCHER.resolve(noYear,{search()},{detail()},{null}).subject==null)
        check(MATCHER.resolve(hotdRequest.copy(year=null),{catalog(hotd)},{envelope(hotd)},{null}).subject!=null)
    }
    test("title-year uniqueness is discovery evidence only; never enough to authorize playback") {
        check(MATCHER.identity(target,item())=="TMDB_UNIQUE_WORK")
        check(MATCHER.resolve(target,{search()},{detail()},{null}).subject==null)
    }
    test("truncated TMDB search cannot establish uniqueness but independent IDs still verify") {
        val req=target.copy(works=MATCHER.tmdbWorks("""{"total_pages":3,"results":[]}""",target))
        check(req.works==null)
        check(MATCHER.resolve(req,{search()},{envelope(item().put("tmdbId","10"))},{null}).subject==movie)
    }
    test("native search pagination examines later candidate before selecting; bounded at three pages") {
        var pages=mutableListOf<Int>()
        val first=catalog(item()).let { JSONObject(it).apply { getJSONObject("data").put("pager",JSONObject().put("hasMore",true)) }.toString() }
        val got=MATCHER.resolve(r,{first},{id -> detail(movie.copy(id=id))},{null},
            {_,page -> pages.add(page);catalog(item(movie.copy(id="124")))})
        check(got.subject==null && pages.contains(2))
        pages.clear()
        MATCHER.resolve(r,{first},{detail()},{null},{_,page -> pages.add(page);first})
        check(pages.all { it in 2..3 } && pages.size<=24)
    }
    test("late official alternative title is searched with a prioritized bounded planner") {
        val aliases=(1..8).map { "International Official Name Variant $it" }
        val req=target.copy(titles=listOf("Primary Name","Original Name")+aliases)
        check(MATCHER.queries(req).contains(aliases.last()))
        val meta=item().put("title",aliases.last()).put("tmdbId","10")
        check(MATCHER.resolve(req,{q -> if(q==aliases.last()) catalog(meta) else catalog()},{envelope(meta)},{null}).subject?.id=="123")
        check(MATCHER.queries(req).size<=12)
    }
    test("Unicode compatibility punctuation and apostrophes keep full-work identity") {
        check(MATCHER.normalize("Ｓｐｉｄｅｒ—Ｍａｎ")=="spider man")
        check(!MATCHER.matches(r,movie.copy(title="Example's Sequel")))
    }
    test("Spider-Man No Way Home and franchise variants never authorize Brand New Day") {
        val req=MATCHER.Request(listOf("Spider-Man: Brand New Day"),2026,1,null,null,tmdbId="969681")
        val other=movie.copy(title="Spider-Man: No Way Home",year=2021)
        var details=0
        check(MATCHER.resolve(req,{search(other)},{details++;detail(other)},{null}).subject==null)
        check(details==0)
        check(MATCHER.resolve(req,{search(other.copy(year=2026))},{detail(other.copy(year=2026))},{null}).subject==null)
    }
    test("nested external ID conflicts survive metadata merging") {
        val merged=MATCHER.mergeMetadata(item().put("externalIds",JSONObject().put("tmdbId","10")),
            JSONObject().put("externalIds",JSONObject().put("tmdbId","11")))
        check(MATCHER.identity(target,merged)=="EXTERNAL_ID_CONFLICT")
    }
    test("metadata cache uses exact keys and expires without retaining playback decisions") {
        var now=0L
        val cache=MATCHER.CatalogCache(30) { now }
        cache.put("movie:10:Example","a");cache.put("tv:10:Example","b");cache.put("movie:11:Example","c")
        check(cache.get("movie:10:Example")=="a" && cache.get("tv:10:Example")=="b")
        check(cache.get("movie:11:Example")=="c")
        now=31;check(cache.get("movie:10:Example")==null)
    }
    test("detail failure is not replaced by search metadata or a different film") {
        var calls=0
        check(MATCHER.resolve(target,{search()},{calls++;null},{null}).subject==null)
        check(calls<=2)
    }

    test("later series edition year needs both cast plot and explicit requested season; never renumbers") {
        val later=JSONObject(hotd.toString()).put("releaseDate","2024-06-16")
        val req=hotdRequest.copy(season=2,episode=4)
        check(MATCHER.resolve(req,{catalog(later)},{envelope(later)},{null}).subject!=null)
        val wrong=JSONObject(later.toString()).put("description","unrelated remake story")
        check(MATCHER.resolve(req,{catalog(wrong)},{envelope(wrong)},{null}).subject==null)
        check(MATCHER.resolve(hotdRequest,{catalog(later)},{envelope(later)},{null}).subject==null)
    }
    test("detail concurrency is bounded and repeated aliases never create unlimited retries") {
        var active=0;var max=0;var calls=0
        val items=(1..4).map { item(movie.copy(id=it.toString())) }.toTypedArray()
        val got=MATCHER.resolve(r,{catalog(*items)},{id ->
            calls++;active++;max=maxOf(max,active);delay(10);active--;detail(movie.copy(id=id))
        },{null})
        check(got.subject==null && max in 2..3 && calls<=8)
    }
    test("a correct later native page is verified without first-result selection") {
        val first=JSONObject(catalog(item(movie.copy(title="Different Work"))))
            .apply {getJSONObject("data").put("pager",JSONObject().put("hasMore",true))}.toString()
        val got=MATCHER.resolve(target,{first},{envelope(item().put("tmdbId","10"))},{null},
            {_,page -> check(page==2);catalog(item())})
        check(got.subject==movie)
    }
    test("same-name movie TV and wrong year fail even with plausible cast") {
        val meta=item(movie.copy(year=2021)).put("staffList",org.json.JSONArray()
            .put(JSONObject().put("name","Actor A")).put(JSONObject().put("name","Actor B")))
        val req=target.copy(castNames=listOf("Actor A","Actor B"))
        check(MATCHER.resolve(req,{catalog(meta)},{envelope(meta)},{null}).subject==null)
        check(MATCHER.resolve(req,{catalog(item(movie.copy(type=2)).put("tmdbId","10"))},
            {envelope(item(movie.copy(type=2)).put("tmdbId","10"))},{null}).subject==null)
    }

    test("failed media subject can be excluded while later aliases still require full same-work proof") {
        val req=target.copy(titles=listOf("Example","Official Alternate"),excludedSubjects=setOf("123"))
        val later=item(movie.copy(id="124")).put("tmdbId","10")
        val first=item().put("tmdbId","10")
        val got=MATCHER.resolve(req,{q -> catalog(if(q=="Official Alternate") later else first)},
            {id -> envelope(if(id=="123") first else later)},{null})
        check(got.subject?.id=="124" && got.editions.none { it.subject.id=="123" })
        val bad=JSONObject(later.toString()).put("tmdbId","11")
        check(MATCHER.resolve(req,{q -> catalog(if(q=="Official Alternate") bad else first)},
            {id -> envelope(if(id=="123") first else bad)},{null}).subject==null)
    }

    val server=HttpServer.create(InetSocketAddress("127.0.0.1",0),0)
    server.createContext("/") { ex ->
        val bytes=byteArrayOf(0,0,0,24)+"ftypisom".toByteArray()+ByteArray(128)
        ex.sendResponseHeaders(200,bytes.size.toLong());ex.responseBody.use { it.write(bytes) }
    }
    server.start()
    val media="http://127.0.0.1:${server.address.port}/sample.mp4"
    fun response(req: Request, body: String, token: Boolean=false)=Response.Builder().request(req)
        .protocol(Protocol.HTTP_1_1).code(200).message("fixture").body(body.toResponseBody("application/json".toMediaType()))
        .apply { if(token) header("x-user","{\"token\":\"fixture-anonymous\"}") }.build()
    var tv=false
    PlaybackApiFixture.responder={ req ->
        val subject=movie.copy(type=if(tv) 2 else 1)
        when {
            req.url.host=="api.themoviedb.org" -> response(req,"""{"results":[{"id":1,"title":"Example","name":"Example","release_date":"2022-01-01","first_air_date":"2022-01-01"}]}""")
            req.url.encodedPath.endsWith("ranking-list") -> response(req,"{}",true)
            req.url.encodedPath.endsWith("search/v2") -> response(req,search(subject))
            req.url.encodedPath.endsWith("/get") -> response(req,envelope(raw(subject).put("tmdbId","1")))
            req.url.encodedPath.endsWith("season-info") -> response(req,seasons)
            req.url.encodedPath.endsWith("subject/play") -> response(req,"""{"code":0,"data":{"subjectId":"123","se":${if(tv) 2 else 0},"ep":${if(tv) 4 else 0},"streams":[{"id":"s1","url":"$media"}]}}""")
            else -> response(req,"{\"code\":0,\"data\":{}}")
        }
    }
    suspend fun throughRegisteredProvider(isTv: Boolean): List<ExtractorLink> {
        tv=isTv;PlaybackApiFixture.requests.clear()
        val links=mutableListOf<ExtractorLink>();val subs=mutableListOf<SubtitleFile>()
        val payload="""{"id":1,"tmdbId":"1","title":"Example","year":2022,"type":"${if(tv) "tv" else "movie"}","isTvSeries":$tv,"season":${if(tv) 2 else 9},"episode":${if(tv) 4 else 9}}"""
        check(PROVIDER().loadLinks(payload,false,subs::add,links::add))
        check(links.single().source == "Moviebox")
        check(PlaybackApiFixture.requests.none { it.url.encodedPath.contains("play-info") })
        val play=PlaybackApiFixture.requests.first { it.url.encodedPath.endsWith("subject/play") }
        check(play.url.queryParameter("se") == if(tv) "2" else "0")
        check(play.url.queryParameter("ep") == if(tv) "4" else "0")
        return links
    }
    try {
        test("registered MainAPI movie maps to H5 0/0 and local media validates") { throughRegisteredProvider(false) }
        test("registered MainAPI series maps exact 2/4 and owns link source") { throughRegisteredProvider(true) }
        test("Insidious MainAPI survives failed mobile auth using verified public H5 context") {
            val html=java.io.File(System.getProperty("migration.fixtures"),"insidious-public-nuxt.html").readText()
            PlaybackApiFixture.requests.clear()
            PlaybackApiFixture.responder={ req ->
                when {
                    req.url.host=="api.themoviedb.org" -> if(req.url.encodedPath.contains("/search/")) response(req,"""{"results":[{"id":1291595,"title":"Insidious: Out of the Further","release_date":"2026-08-19"}]}""") else response(req,JSONObject().put("id",1291595).put("overview",insidious.getString("description")).toString())
                    req.url.host=="moviebox.ph" -> {
                        check(req.header("Authorization")==null)
                        response(req,html)
                    }
                    req.url.encodedPath.endsWith("subject/play") -> {
                        check(req.url.queryParameter("subjectId")==originalId)
                        check(req.url.queryParameter("detailPath")==insidious.getString("detailPath"))
                        response(req,"""{"code":0,"data":{"subjectId":"$originalId","se":0,"ep":0,"streams":[{"id":"s1","url":"$media"}]}}""")
                    }
                    else -> response(req,"{\"code\":403}").newBuilder().code(403).build()
                }
            }
            val links=mutableListOf<ExtractorLink>();val subs=mutableListOf<SubtitleFile>()
            val payload="""{"id":1291595,"tmdbId":"1291595","title":"Insidious: Out of the Further","year":2026,"type":"movie","isTvSeries":false}"""
            check(PROVIDER().loadLinks(payload,false,subs::add,links::add))
            check(links.single().source=="Moviebox")
            check(PlaybackApiFixture.requests.none { it.url.encodedPath.contains("play-info") })
        }

        test("registered MainAPI hydrates same-ID English Indonesian translations before verified H5 callback") {
            val meta=item().put("title","Moon Sailor").put("staffList",org.json.JSONArray().put(JSONObject().put("name","Actor A")).put(JSONObject().put("name","Actor B")))
                .put("detailPath","moon-sailor-authoritative-path")
            val table=org.json.JSONArray().put(JSONObject().put("subjectId",1).put("title",2).put("subjectType",3).put("releaseDate",4).put("detailPath",5))
                .put("123").put("Moon Sailor").put(1).put("2022-01-01").put("moon-sailor-authoritative-path")
            val page="<script id=__NUXT_DATA__ type=application/json>$table</script>"
            PlaybackApiFixture.requests.clear()
            PlaybackApiFixture.responder={ req -> when {
                req.url.host=="api.themoviedb.org" -> {
                    if(req.url.encodedPath.contains("/search/")) response(req,"{\"results\":[]}") else {
                        check(req.url.queryParameter("append_to_response")?.contains("translations")==true)
                        response(req,translated.toString())
                    }
                }
                req.url.host=="moviebox.ph" -> response(req,page)
                req.url.encodedPath.endsWith("subject-api/get") -> response(req,envelope(meta))
                req.url.encodedPath.endsWith("ranking-list") -> response(req,"{}",true)
                req.url.encodedPath.endsWith("subject/play") -> {
                    check(req.url.queryParameter("subjectId")=="123" && req.url.queryParameter("se")=="0" && req.url.queryParameter("ep")=="0")
                    response(req,"""{"code":0,"data":{"subjectId":"123","se":0,"ep":0,"streams":[{"id":"s1","url":"$media"}]}}""")
                }
                else -> response(req,"{}")
            } }
            val links=mutableListOf<ExtractorLink>()
            val payload="""{"id":10,"tmdbId":"10","title":"Pelaut di Bulan","year":2022,"type":"movie","isTvSeries":false}"""
            check(PROVIDER().loadLinks(payload,false,{},links::add))
            check(links.single().source=="Moviebox")
        }
        test("recorded Spider-Man MainAPI verifies work and H5 path without consulting optional aliases") {
            val html=java.io.File(System.getProperty("migration.fixtures"),"spiderman-public-stars-nuxt.html").readText()
            PlaybackApiFixture.requests.clear()
            PlaybackApiFixture.responder={ req ->
                when {
                    req.url.host=="api.themoviedb.org" -> if(req.url.encodedPath.contains("/search/")) response(req,"""{"results":[{"id":969681,"title":"Spider-Man: Brand New Day","release_date":"2026-07-29"}]}""") else response(req,java.io.File(System.getProperty("migration.fixtures"),"spiderman-tmdb-bilingual.json").readText())
                    req.url.host=="moviebox.ph" -> {
                        if(req.url.encodedPath.contains("searchResult"))
                            check(req.url.queryParameter("keyword")=="Spider-Man: Brand New Day")
                        response(req,html)
                    }
                    req.url.encodedPath.endsWith("subject/play") -> {
                        check(req.url.queryParameter("subjectId")=="6026412232966389904")
                        check(req.url.queryParameter("detailPath")=="spider-man-brand-new-day-Aea8ARY1bb7")
                        check(req.url.queryParameter("se")=="0" && req.url.queryParameter("ep")=="0")
                        response(req,"""{"code":0,"data":{"subjectId":"6026412232966389904","se":0,"ep":0,"streams":[{"id":"s1","url":"$media"}]}}""")
                    }
                    else -> response(req,"{\"code\":403}").newBuilder().code(403).build()
                }
            }
            val links=mutableListOf<ExtractorLink>();val subs=mutableListOf<SubtitleFile>()
            val payload="""{"id":969681,"tmdbId":"969681","title":"Spider-Man: Brand New Day","year":2026,"type":"movie","isTvSeries":false,"alternativeTitles":["Spider-Man 3"]}"""
            check(PROVIDER().loadLinks(payload,false,subs::add,links::add))
            check(links.single().source=="Moviebox")
            check(PlaybackApiFixture.requests.count { it.url.encodedPath.contains("searchResult") }==1)
        }
        test("House of the Dragon MainAPI uses public seasons after mobile auth failure with exact requested indices") {
            val html=java.io.File(System.getProperty("migration.fixtures"),"hotd-public-nuxt.html").readText()
            for((se,ep) in listOf(1 to 1,2 to 4,2 to 9)) {
                PlaybackApiFixture.requests.clear()
                PlaybackApiFixture.responder={ req -> when {
                    req.url.host=="api.themoviedb.org" -> response(req,JSONObject().put("id",94997).put("overview",hotd.getString("description")).toString())
                    req.url.host=="moviebox.ph" -> response(req,html)
                    req.url.encodedPath.endsWith("subject/play") -> {
                        check(req.url.queryParameter("se")==se.toString() && req.url.queryParameter("ep")==ep.toString())
                        check(req.url.queryParameter("subjectId")==hotd.getString("subjectId"))
                        response(req,"""{"code":0,"data":{"subjectId":"${hotd.getString("subjectId")}","se":$se,"ep":$ep,"streams":[{"id":"s1","url":"$media"}]}}""")
                    }
                    else -> response(req,"{\"code\":403}").newBuilder().code(403).build()
                } }
                val links=mutableListOf<ExtractorLink>();val subs=mutableListOf<SubtitleFile>()
                val payload="""{"id":94997,"tmdbId":"94997","title":"House of the Dragon","year":2022,"airedYear":2022,"type":"tv","isTvSeries":true,"season":$se,"episode":$ep}"""
                val played=PROVIDER().loadLinks(payload,false,subs::add,links::add)
                check(played==(ep!=9))
                if(ep==9) check(links.isEmpty() && PlaybackApiFixture.requests.none { it.url.encodedPath.endsWith("subject/play") })
                else check(links.single().source=="Moviebox")
            }
        }
        test("MainAPI continues discovery after empty H5 and never recovers through a conflicting work") {
            for(conflict in listOf(false,true)) {
                PlaybackApiFixture.requests.clear()
                PlaybackApiFixture.responder={ req -> when {
                    req.url.host=="api.themoviedb.org" -> response(req,"{}")
                    req.url.encodedPath.endsWith("ranking-list") -> response(req,"{}",true)
                    req.url.encodedPath.endsWith("search/v2") -> {
                        val buffer=okio.Buffer();req.body!!.writeTo(buffer)
                        val query=JSONObject(buffer.readUtf8()).getString("keyword")
                        response(req,search(movie.copy(id=if(query=="Official Alternate") "124" else "123")))
                    }
                    req.url.encodedPath.endsWith("/get") -> {
                        val id=req.url.queryParameter("subjectId")!!
                        response(req,envelope(item(movie.copy(id=id)).put("tmdbId",if(conflict && id=="124") "2" else "1")))
                    }
                    req.url.encodedPath.endsWith("subject/play") -> {
                        val id=req.url.queryParameter("subjectId")!!
                        check(!conflict || id!="124")
                        response(req,if(id=="124") """{"code":0,"data":{"subjectId":"124","se":0,"ep":0,"streams":[{"id":"s1","url":"$media"}]}}"""
                            else """{"code":0,"data":{"streams":[]}}""")
                    }
                    else -> response(req,"{}")
                } }
                val links=mutableListOf<ExtractorLink>();val subs=mutableListOf<SubtitleFile>()
                val payload="""{"id":1,"tmdbId":"1","title":"Example","year":2022,"type":"movie","isTvSeries":false,"alternativeTitles":["Official Alternate"]}"""
                val played=PROVIDER().loadLinks(payload,false,subs::add,links::add)
                check(played==!conflict)
                if(conflict) check(links.isEmpty()) else check(links.single().source=="Moviebox")
                val queries=PlaybackApiFixture.requests.filter { it.url.encodedPath.endsWith("search/v2") }.map { req ->
                    val buffer=okio.Buffer();req.body!!.writeTo(buffer);JSONObject(buffer.readUtf8()).getString("keyword")
                }
                check(queries.size==2 && queries.distinct().size==2)
            }
        }
    } finally {
        server.stop(0)
        com.lagradost.cloudstream3.app.baseClient.connectionPool.evictAll()
        com.lagradost.cloudstream3.app.baseClient.dispatcher.executorService.shutdown()
        PLAYBACK.client.connectionPool.evictAll()
        PLAYBACK.client.dispatcher.executorService.shutdown()
    }
    println("MAPPING $count PASS; fixture/local HTTP only; device NOT_TESTED")
}
