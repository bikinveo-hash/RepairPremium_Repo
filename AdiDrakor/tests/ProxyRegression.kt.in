package PACKAGE.sources

import java.net.*
import java.io.*
import java.util.concurrent.CopyOnWriteArrayList
import javax.crypto.Cipher
import javax.crypto.spec.IvParameterSpec
import javax.crypto.spec.SecretKeySpec
import java.security.MessageDigest

/** Real loopback server and transport code, synthetic upstream bytes only. */
fun main() {
    var count=0
    fun test(name: String, block: ()->Unit) { block();count++;println("PASS proxy $name") }
    val ts=ByteArray(188*50) { if(it%188==0) 0x47 else (it%127).toByte() }
    val wrapped=ByteArray(941)+ts
    val mp4=byteArrayOf(0,0,0,24)+"ftypisom".toByteArray()+ByteArray(100_000)
    val key=MessageDigest.getInstance("MD5").digest("fixture.bin".toByteArray()).joinToString("") { "%02x".format(it) }.toByteArray()
    val cipher=Cipher.getInstance("AES/CTR/NoPadding").apply { init(Cipher.ENCRYPT_MODE,SecretKeySpec(key,"AES"),IvParameterSpec(key.copyOfRange(0,16))) }
    val encrypted=cipher.doFinal(mp4.copyOfRange(0,65536))+mp4.copyOfRange(65536,mp4.size)
    val upstream=CopyOnWriteArrayList<Pair<String,String?>>()
    URL.setURLStreamHandlerFactory { protocol -> if(protocol!="https") null else object: URLStreamHandler() {
        override fun openConnection(url: URL): URLConnection = object: HttpURLConnection(url) {
            override fun connect() = Unit
            override fun disconnect() = Unit
            override fun usingProxy() = false
            val bytes: ByteArray get() = when(url.path) {
                "/master.m3u8" -> "#EXTM3U\n#EXT-X-STREAM-INF:BANDWIDTH=100,RESOLUTION=1280x720\nvariant.m3u8\n#EXT-X-I-FRAME-STREAM-INF:BANDWIDTH=50,URI=\"preview.m3u8\"\n".toByteArray()
                "/variant.m3u8" -> "#EXTM3U\n#EXTINF:5,\nsegment.png\n".toByteArray()
                "/fixture.bin" -> encrypted
                else -> wrapped
            }
            val range: Pair<Int,Int>? get() = getRequestProperty("Range")?.let {
                val values=it.substringAfter("bytes=").split('-')
                (values[0].toIntOrNull() ?: 0) to (values.getOrNull(1)?.toIntOrNull()?.coerceAtMost(bytes.size-1) ?: bytes.size-1)
            }
            override fun getResponseCode(): Int = if(url.path=="/redirect") 302 else if(range!=null) 206 else 200
            override fun getInputStream(): InputStream {
                upstream+=url.path to getRequestProperty("Range")
                return ByteArrayInputStream(range?.let { bytes.copyOfRange(it.first,it.second+1) } ?: bytes)
            }
            override fun getHeaderField(name: String): String? = when(name.lowercase()) {
                "content-type" -> if(url.path.endsWith("m3u8")) "application/vnd.apple.mpegurl" else "application/octet-stream"
                "content-length" -> (range?.let { it.second-it.first+1 } ?: bytes.size).toString()
                "content-range" -> range?.let { "bytes ${it.first}-${it.second}/${bytes.size}" }
                "location" -> if(url.path=="/redirect") "https://unapproved.fixture/media" else null
                else -> null
            }
        }
    } }
    fun fetch(url: String, range: String?=null): Triple<Int,ByteArray,String?> {
        val c=URL(url).openConnection() as HttpURLConnection
        c.connectTimeout=2000;c.readTimeout=3000
        range?.let { c.setRequestProperty("Range",it) }
        try { val code=c.responseCode;val body=(if(code<400) c.inputStream else c.errorStream)?.readBytes() ?: byteArrayOf()
            return Triple(code,body,c.getHeaderField("Content-Range"))
        } finally { c.disconnect() }
    }
    try {
        test("lazy listener and port chosen by kernel") { check(!LocalProxy.isRunning);check(LocalProxy.proxyUrl("https://cdn.turboviplay.com/master.m3u8")!=null);check(LocalProxy.port>0) }
        val port=LocalProxy.port
        test("idempotent listener no port collision") { repeat(10) { check(LocalProxy.start());check(LocalProxy.port==port) } }
        test("allowlist rejects unrelated host credentials and nonstandard port") {
            for(u in listOf("https://evil.fixture/x","http://cdn.turboviplay.com/x","https://user@cdn.turboviplay.com/x","https://cdn.turboviplay.com:8443/x")) check(!LocalProxy.isAllowed(u))
        }
        test("master and variant HLS are rewritten recursively") {
            val master=fetch(LocalProxy.proxyUrl("https://cdn.turboviplay.com/master.m3u8")!!)
            check(master.first==200);val text=String(master.second);check(text.startsWith("#EXTM3U"))
            val variant=text.lines().first { it.startsWith("http://127.0.0.1") }
            val pl=fetch(variant);check(String(pl.second).startsWith("#EXTM3U"))
            val segment=String(pl.second).lines().first { it.startsWith("http://127.0.0.1") }
            check(fetch(segment).second.contentEquals(ts))
        }
        test("seek Range translates PNG prefix and content range") {
            val result=fetch(LocalProxy.proxyUrl("https://cdn.turboviplay.com/segment.png")!!,"bytes=188-375")
            check(result.first==206);check(result.second.contentEquals(ts.copyOfRange(188,376)));check(result.third=="bytes 188-375/${ts.size}")
        }
        test("clean FileLions master drops preview tracks and retains variants") {
            val pl=String(fetch(LocalProxy.proxyUrl("https://cdn.turboviplay.com/master.m3u8",true)!!).second)
            check("I-FRAME" !in pl);check("https://cdn.turboviplay.com/variant.m3u8" in pl)
        }
        test("redirect to unapproved host refused") { check(fetch(LocalProxy.proxyUrl("https://cdn.turboviplay.com/redirect")!!).first==502) }
        test("Hydrax encrypted MP4 prefix and binary Range resume") {
            val local=LocalProxy.hydraxUrl("https://fixture.sssrr.org/fixture.bin",mp4.size.toLong(),mp4.size.toLong())!!
            check(fetch(local).second.contentEquals(mp4))
            val result=fetch(local,"bytes=65530-65550")
            check(result.first==206);check(result.second.contentEquals(mp4.copyOfRange(65530,65551)));check(result.third=="bytes 65530-65550/${mp4.size}")
        }
        test("stop closes listener; new listener restarts") { LocalProxy.stop();check(!LocalProxy.isRunning);check(LocalProxy.start());check(LocalProxy.isRunning) }
    } finally { LocalProxy.stop() }
    println("PROXY $count PASS; local HTTP + synthetic upstream fixtures; Android player NOT_TESTED")
}
