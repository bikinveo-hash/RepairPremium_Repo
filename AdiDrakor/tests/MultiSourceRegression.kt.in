package PACKAGE.sources

import com.lagradost.cloudstream3.*
import com.lagradost.cloudstream3.utils.*
import kotlinx.coroutines.*
import okhttp3.*
import okhttp3.MediaType.Companion.toMediaType
import okhttp3.ResponseBody.Companion.toResponseBody
import org.json.JSONObject
import org.jsoup.Jsoup
import java.util.concurrent.CopyOnWriteArrayList

/** Actual adapters/orchestrator, deterministic catalog and extraction fixtures; no public playback claims. */
fun main() = runBlocking {
    var count=0
    suspend fun test(name: String, block: suspend ()->Unit) { block(); count++; println("PASS multisource $name") }
    val movie=MediaIdentity.Request(listOf("Spider-Man: Brand New Day","Spider-Man: Hari Baru"),2026,1,null,null,"969681")
    fun candidate(title: String="Spider-Man: Brand New Day", year: Int?=2026, type: Int=1, id: String?=null) =
        MediaIdentity.Candidate("movie",listOf(title),year,type,id)
    test("verified English and Indonesian aliases") { check(MediaIdentity.matches(movie,candidate("Spider-Man: Hari Baru"))) }
    test("punctuation normalization") { check(MediaIdentity.matches(movie,candidate("Spider Man Brand New Day"))) }
    test("similar title rejected") { check(!MediaIdentity.matches(movie,candidate("Spider-Man: No Way Home"))) }
    test("remake wrong year rejected") { check(!MediaIdentity.matches(movie,candidate(year=2002))) }
    test("movie versus series rejected even same ID") { check(!MediaIdentity.matches(movie,candidate(type=2,id="969681"))) }
    test("conflicting ID rejected even exact title") { check(!MediaIdentity.matches(movie,candidate(id="123"))) }
    test("missing year fails closed without ID") { check(!MediaIdentity.matches(movie,candidate(year=null))) }
    test("verified ID accepts missing source year") { check(MediaIdentity.matches(movie,candidate(year=null,id="969681"))) }
    test("empty metadata rejected") { check(!MediaIdentity.matches(movie.copy(titles=emptyList()),candidate())) }
    test("ambiguous exact candidates rejected") { check(MediaIdentity.select(movie,listOf(candidate(),candidate().copy(key="other")))==null) }
    test("unrelated Indonesian title not inferred") { check(!MediaIdentity.matches(movie.copy(titles=listOf("Spider-Man: Brand New Day")),candidate("Spider-Man: Hari Baru"))) }
    val tv=movie.copy(type=2,season=2,episode=3)
    val rows=listOf(MediaIdentity.Episode("https://episode/one",1,3),MediaIdentity.Episode("https://episode/two",2,3),MediaIdentity.Episode("https://episode/three",2,4))
    test("exact season episode") { check(MediaIdentity.episode(tv,rows)?.url=="https://episode/two") }
    test("wrong season rejected") { check(MediaIdentity.episode(tv,rows.filter { it.season==1 })==null) }
    test("missing episode rejected") { check(MediaIdentity.episode(tv.copy(episode=8),rows)==null) }
    test("ambiguous episode rejected") { check(MediaIdentity.episode(tv,rows+MediaIdentity.Episode("https://episode/duplicate",2,3))==null) }
    test("unknown episode never defaults to one") { check(!MediaIdentity.valid(tv.copy(episode=null))) }
    val headers=mapOf("Origin" to "https://idlix.fixture", "Referer" to "https://idlix.fixture/movie", "Authorization" to "fixture-header", "User-Agent" to "fixture-agent")
    suspend fun stream(url: String="https://media.fixture/video.m3u8", quality: Int=720): ExtractorLink = newExtractorLink("Fixture","Actual mirror",url,ExtractorLinkType.M3U8) {
        this.quality=quality; this.headers=headers; this.referer=headers.getValue("Referer");this.extractorData="fixture-data"
    }
    for(mask in 0..7) test("availability mask $mask retains every available source") {
        val links=CopyOnWriteArrayList<ExtractorLink>();val subs=CopyOnWriteArrayList<SubtitleFile>()
        val multi=MultiSource("fixture",idlix={ _,s,l -> if(mask and 2!=0) { s(newSubtitleFile("Indonesian","https://media.fixture/id.vtt"));l(stream("https://media.fixture/idlix.m3u8")) } },
            oppa={ _,_,l -> if(mask and 4!=0) l(stream("https://media.fixture/oppa.m3u8")) },enrich={ it })
        val ok=multi.resolve(movie,subs::add,links::add) { _,l -> if(mask and 1!=0) l(stream("https://media.fixture/moviebox.m3u8")) }
        check(ok==(mask!=0));check(links.size==Integer.bitCount(mask));check(subs.size==if(mask and 2!=0) 1 else 0)
        links.forEach { check(it.name.startsWith(it.source+" • "));check(it.headers==headers);check(it.quality==720);check(it.extractorData=="fixture-data") }
    }
    test("one failing source leaves two good streams") {
        val links=CopyOnWriteArrayList<ExtractorLink>()
        val multi=MultiSource("fixture",idlix={ _,_,_ -> error("offline fixture") },oppa={ _,_,l -> l(stream()) },enrich={ it })
        check(multi.resolve(movie,{},links::add) { _,l -> l(stream("https://media.fixture/mb.m3u8")) });check(links.size==2)
    }
    test("duplicate stream/subtitle URLs emitted once under concurrent callbacks") {
        val links=CopyOnWriteArrayList<ExtractorLink>();val subs=CopyOnWriteArrayList<SubtitleFile>()
        val shared=stream();val sub=newSubtitleFile("en","https://media.fixture/sub.vtt")
        val multi=MultiSource("fixture",idlix={ _,s,l -> repeat(20) { l(shared);s(sub) } },oppa={ _,s,l -> repeat(20) { l(shared);s(sub) } },enrich={ it })
        check(multi.resolve(movie,subs::add,links::add) { s,l -> repeat(20) { l(shared);s(sub) } });check(links.size==1 && subs.size==1)
    }
    test("Moviebox emits before slow additional metadata") {
        val first=CompletableDeferred<String>();val release=CompletableDeferred<Unit>()
        val multi=MultiSource("fixture",idlix={ _,_,_ -> },oppa={ _,_,_ -> },enrich={ release.await();it })
        coroutineScope {
            val task=async { multi.resolve(movie,{}, { first.complete(it.source) }) { _,l -> l(stream()) } }
            check(withTimeout(1000) { first.await() }=="Moviebox");check(!task.isCompleted);release.complete(Unit);check(task.await())
        }
    }
    test("source timeout preserves earlier result and rejects late callback") {
        val links=CopyOnWriteArrayList<ExtractorLink>();var late: ((ExtractorLink)->Unit)?=null
        val multi=MultiSource("fixture",idlix={ _,_,l -> late=l;delay(2000) },oppa={ _,_,_ -> delay(120) },enrich={ it },timeouts=listOf(1000,40,1000))
        check(multi.resolve(movie,{},links::add) { _,l -> l(stream()) });check(links.size==1)
        check(runCatching { late!!(stream("https://media.fixture/late.m3u8")) }.exceptionOrNull() is CancellationException);check(links.size==1)
    }
    test("parent cancellation propagates and stops all children") {
        val entered=CompletableDeferred<Unit>();val stopped=CompletableDeferred<Unit>()
        val multi=MultiSource("fixture",idlix={ _,_,_ -> entered.complete(Unit);try { awaitCancellation() } finally { stopped.complete(Unit) } },oppa={ _,_,_ -> awaitCancellation() },enrich={ it })
        coroutineScope { val task=async { multi.resolve(movie,{}, {}) { _,_ -> awaitCancellation() } };entered.await();task.cancel();task.join();check(task.isCancelled);check(stopped.isCompleted) }
    }
    test("malformed/nonmedia URL cannot make source successful") {
        val multi=MultiSource("fixture",idlix={ _,_,l -> l(stream("javascript:bad")) },oppa={ _,_,_ -> },enrich={ it })
        check(!multi.resolve(movie,{}, {}) { _,_ -> })
    }
    fun response(request: Request, body: String, code: Int=200): Response = Response.Builder().request(request).protocol(Protocol.HTTP_1_1)
        .code(code).message("fixture").body(body.toResponseBody("application/json".toMediaType())).build()
    test("Idlix catalog ID and correct series episode with session cookies/header flow") {
        val requested=CopyOnWriteArrayList<String>();var claimed=false;var major=false;var waited=0L
        val source=IdlixSource(get={ url,h,c ->
            requested+=url
            when {
                url.contains("/api/search") -> """{"data":[{"title":"Spider-Man: Hari Baru","slug":"selected","contentType":"series"}]}"""
                url.contains("/season/2") -> """{"season":{"seasonNumber":2,"episodes":[{"id":"WRONG_EP","episodeNumber":2,"hasVideo":true},{"id":"catalog-ep-23","episodeNumber":3,"hasVideo":true}]}}"""
                url.contains("/play-info/") -> { check(url.endsWith("episode/catalog-ep-23"));check(c["did"]?.length==32);check(h["Referer"]?.endsWith("series/selected")==true);"""{"gateToken":"gate-fixture","preroll":{"countdownSec":7}}""" }
                url.contains("/api/series/") -> """{"id":"catalog-series-9","title":"Spider-Man: Brand New Day","firstAirDate":"2026-01-01"}"""
                else -> "{}"
            }
        },post={ url,body,_,c -> check(url.endsWith("session/claim"));check(JSONObject(body).getString("gateToken")=="gate-fixture");check(c["NEXT_LOCALE"]=="id");claimed=true;"""{"claim":"claim-fixture"}""" },
        major={ u,r,_,_ -> check(u.endsWith("claim=claim-fixture"));check(r.endsWith("series/selected"));major=true },wait={ waited=it })
        source.resolve(tv,{},{});check(claimed && major && waited==8000L);check(requested.none { it.endsWith("episode/969681") })
    }
    test("Idlix missing requested episode does not claim") {
        val source=IdlixSource(get={ url,_,_ -> when { url.contains("/api/search") -> """{"data":[{"title":"Spider-Man: Brand New Day","slug":"selected","contentType":"series"}]}"""
            url.contains("/season/") -> """{"season":{"seasonNumber":2,"episodes":[{"id":"e24","episodeNumber":4,"hasVideo":true}]}}"""
            else -> """{"title":"Spider-Man: Brand New Day","firstAirDate":"2026-01-01"}""" } },post={ _,_,_,_ -> error("must not claim") },major={ _,_,_,_ -> error("must not extract") },wait={})
        source.resolve(tv,{}, {})
    }
    test("Idlix gate denial has no invented token or player fallback") {
        var play=false
        val source=IdlixSource(get={ url,_,_ -> when { url.contains("/api/search") -> """{"data":[{"title":"Spider-Man: Brand New Day","slug":"selected","contentType":"movie"}]}"""
            url.contains("play-info") -> { play=true;null }
            else -> """{"id":"catalog9","title":"Spider-Man: Brand New Day","releaseDate":"2026-01-01"}""" } },post={ _,_,_,_ -> error("denied") },major={ _,_,_,_ -> error("denied") },wait={})
        source.resolve(movie,{},{});check(play)
    }
    test("Idlix too-long server timer is respected by skipping claim") {
        val source=IdlixSource(get={ url,_,_ -> when { url.contains("/api/search") -> """{"data":[{"title":"Spider-Man: Brand New Day","slug":"selected","contentType":"movie"}]}"""
            url.contains("play-info") -> """{"gateToken":"gate","preroll":{"countdownSec":100}}"""
            else -> """{"id":"c9","title":"Spider-Man: Brand New Day","releaseDate":"2026-01-01"}""" } },post={ _,_,_,_ -> error("too soon") },major={ _,_,_,_ -> error("too soon") },wait={ error("too long") })
        source.resolve(movie,{}, {})
    }
    fun oppaPage(type: String="Drama",year: Int=2026,episodes: String="") = """<h1 class="entry-title">Spider-Man: Brand New Day Season 2</h1><div class="spe"><span>Tipe: $type</span><span>Rilis: $year</span></div><div class="eplister"><ul>$episodes</ul></div>"""
    val episodeHtml="""<li><a href="/selected-episode-3/"><span class="epl-title">Episode 3</span></a></li><li><a href="/selected-episode-4/">Episode 4</a></li>"""
    test("Oppa verifies catalog year type season before selecting actual episode") {
        var selected=""
        val source=OppaSource(get={ u -> if(u.contains("?s=")) """<div class="listupd"><div class="bsx"><a href="/series/selected/"><div class="tt"><h2>Spider-Man: Brand New Day Season 2</h2></div></a></div></div>""" else oppaPage(episodes=episodeHtml) },playback={ u,_,_ -> selected=u })
        source.resolve(tv,{},{});check(selected=="https://oppadrama.io/selected-episode-3/")
    }
    test("Oppa missing year refuses a title-only replacement") {
        val c=MediaIdentity.oppa("https://oppa/selected",Jsoup.parse(oppaPage().replace("<span>Rilis: 2026</span>","")))!!
        check(!MediaIdentity.matches(tv,c))
    }
    test("Oppa no season labels never maps unnumbered catalog to season two") {
        val doc=Jsoup.parse(oppaPage(episodes=episodeHtml).replace(" Season 2",""),"https://oppadrama.io/selected")
        val c=MediaIdentity.oppa("selected",doc)!!
        check(MediaIdentity.episode(tv,MediaIdentity.oppaEpisodes(doc,c))==null)
    }
    test("Oppa absent episode never fabricates episode one") {
        val doc=Jsoup.parse(oppaPage(),"https://oppadrama.io/selected");check(MediaIdentity.oppaEpisodes(doc,MediaIdentity.oppa("selected",doc)!!).isEmpty())
    }
    test("selected TMDB translations hydrate Indonesian and English source queries") {
        PlaybackApiFixture.responder={ req -> response(req,"""{"id":969681,"title":"Spider-Man: Brand New Day","translations":{"translations":[{"iso_639_1":"id","data":{"title":"Spider-Man: Hari Baru"}}]}}""") }
        var seen=false
        MultiSource("fixture",idlix={ r,_,_ -> check("Spider-Man: Hari Baru" in r.titles);seen=true },oppa={ _,_,_ -> }).resolve(movie.copy(titles=listOf("Spider-Man: Brand New Day")),{}, {}) { _,_ -> }
        check(seen)
    }
    test("metadata from another TMDB ID cannot add translated aliases") {
        PlaybackApiFixture.responder={ req -> response(req,"""{"id":123,"title":"Unrelated Movie","translations":{"translations":[{"iso_639_1":"id","data":{"title":"Wrong Translation"}}]}}""") }
        var seen=false
        MultiSource("fixture",idlix={ r,_,_ -> check("Wrong Translation" !in r.titles && "Unrelated Movie" !in r.titles);seen=true },oppa={ _,_,_ -> }).resolve(movie,{}, {}) { _,_ -> }
        check(seen)
    }
    test("catalog SEO and parenthesized release year retain exact work identity") {
        val doc=Jsoup.parse("<h1 class='entry-title'>Nonton Spider-Man: Brand New Day (2026) Sub Indo</h1><div class='spe'><span>Tipe: Movie</span><span>Rilis: 2026</span></div>")
        check(MediaIdentity.matches(movie,MediaIdentity.oppa("selected",doc)!!))
    }
    test("later season year is accepted only with verified requested season-year metadata") {
        val c=MediaIdentity.Candidate("s2",tv.titles,2027,2,season=2)
        check(!MediaIdentity.matches(tv,c));check(MediaIdentity.matches(tv.copy(seasonYear=2027),c))
        check(!MediaIdentity.matches(tv.copy(seasonYear=2027),c.copy(season=3)))
    }
    test("Majorplay actual resolver preserves Referer Origin subtitle and media type") {
        PlaybackApiFixture.responder={ req -> check(req.url.encodedPath=="/api/play");check(req.header("Origin")=="https://z2.idlixku.com");check(req.header("Referer")=="https://z2.idlixku.com/movie/selected")
            response(req,"""{"url":"https://media.fixture/master.m3u8","subtitles":[{"path":"https://media.fixture/id.vtt","label":"Indonesian"}]}""") }
        val links=mutableListOf<ExtractorLink>();val subs=mutableListOf<SubtitleFile>()
        Majorplay().getUrl("https://e2e.majorplay.net/play?claim=fixture","https://z2.idlixku.com/movie/selected",subs::add,links::add)
        check(links.single().isM3u8 && links.single().quality==Qualities.Unknown.value);check(subs.single().lang=="Indonesian")
        check(links.single().headers["Origin"]=="https://z2.idlixku.com")
    }
    test("Oppa actual base64 mirror resolver produces TurboVIP proxy link, not iframe") {
        val iframe=java.util.Base64.getEncoder().encodeToString("<iframe src='https://turboviplay.com/t/fixture'></iframe>".toByteArray())
        PlaybackApiFixture.responder={ req -> response(req,if(req.url.host=="oppadrama.io") "<select class='mirror'><option value='$iframe'>TurboVIP</option></select>" else "<div id='video_player' data-hash='https://cdn.turboviplay.com/fixture/master.m3u8'></div>") }
        val links=mutableListOf<ExtractorLink>()
        check(!LocalProxy.isRunning)
        check(OppaPlayback().loadLinks("https://oppadrama.io/episode-3",false,{},links::add))
        check(links.single().url.startsWith("http://127.0.0.1:"));check(links.single().isM3u8)
        check(!links.single().url.contains("/t/fixture"));check(LocalProxy.isRunning)
        LocalProxy.stop()
    }
    test("Oppa actual FileLions packed mirror uses clean playlist proxy") {
        val iframe=java.util.Base64.getEncoder().encodeToString("<iframe src='https://minochinos.com/v/fixture'></iframe>".toByteArray())
        val packed="eval(function(p,a,c,k,e,d){return p;}('0:\"1\"',2,2,'hls2|https://cdn.turboviplay.com/master.m3u8'.split('|')))"
        PlaybackApiFixture.responder={ req -> response(req,if(req.url.host=="oppadrama.io") "<select class='mirror'><option value='$iframe'>FileLions</option></select>" else packed) }
        val links=mutableListOf<ExtractorLink>()
        check(OppaPlayback().loadLinks("https://oppadrama.io/episode-3",false,{},links::add))
        check(links.single().url.startsWith("http://127.0.0.1:") && links.single().url.endsWith("&clean=1"))
        check(links.single().isM3u8);LocalProxy.stop()
    }
    test("Oppa actual Hydrax config decryption resolves seekable storage proxy") {
        val iframe=java.util.Base64.getEncoder().encodeToString("<iframe src='https://abyssplayer.com/?v=fixture'></iframe>".toByteArray())
        val payload=JSONObject().put("mp4",JSONObject().put("sources",org.json.JSONArray().put(JSONObject()
            .put("label","720p").put("codec","h264").put("size",100000).put("partSize",100000)
            .put("url","https://fixture.sssrr.org").put("path","fixture.bin"))))
        val key=java.security.MessageDigest.getInstance("MD5").digest("user:fixture:media".toByteArray()).joinToString("") { "%02x".format(it) }.toByteArray()
        val cipher=javax.crypto.Cipher.getInstance("AES/CTR/NoPadding").apply { init(javax.crypto.Cipher.ENCRYPT_MODE,javax.crypto.spec.SecretKeySpec(key,"AES"),javax.crypto.spec.IvParameterSpec(key.copyOfRange(0,16))) }
        val data=JSONObject().put("slug","fixture").put("md5_id","media").put("user_id","user")
            .put("media",String(cipher.doFinal(payload.toString().toByteArray()),Charsets.ISO_8859_1))
        val b64=java.util.Base64.getEncoder().encodeToString(data.toString().toByteArray(Charsets.ISO_8859_1))
        PlaybackApiFixture.responder={ req -> response(req,if(req.url.host=="oppadrama.io") "<select class='mirror'><option value='$iframe'>Hydrax</option></select>" else "<script>var config='$b64';</script>") }
        val links=mutableListOf<ExtractorLink>()
        check(OppaPlayback().loadLinks("https://oppadrama.io/episode-3",false,{},links::add))
        check(links.single().url.startsWith("http://127.0.0.1:") && links.single().url.contains("/hx?id="))
        check(links.single().quality==720 && links.single().type==ExtractorLinkType.VIDEO);LocalProxy.stop()
    }
    test("Oppa extraction cancellation escapes nested mirror wrappers") {
        val iframe=java.util.Base64.getEncoder().encodeToString("<iframe src='https://turboviplay.com/t/fixture'></iframe>".toByteArray())
        PlaybackApiFixture.responder={ req -> response(req,if(req.url.host=="oppadrama.io") "<select class='mirror'><option value='$iframe'>TurboVIP</option></select>" else "<div id='video_player' data-hash='https://cdn.turboviplay.com/fixture/master.m3u8'></div>") }
        check(runCatching { OppaPlayback().loadLinks("https://oppadrama.io/episode",false,{}, { throw CancellationException("fixture cancel") }) }.exceptionOrNull() is CancellationException)
        LocalProxy.stop()
    }
    test("additional interceptor retains Authorization Origin Referer Range") {
        val client=OkHttpClient.Builder().addInterceptor(MultiSource.additionalInterceptor()).addInterceptor { chain ->
            check(chain.request().header("Authorization")=="fixture-header");check(chain.request().header("Range")=="bytes=100-200")
            check(chain.request().header("Origin")=="https://idlix.fixture");response(chain.request(),"#EXTM3U") }.build()
        val builder=Request.Builder().url("https://media.fixture/master.m3u8").header("Range","bytes=100-200")
        headers.forEach { (k,v) -> builder.header(k,v) };client.newCall(builder.build()).execute().close()
    }
    app.baseClient.dispatcher.executorService.shutdown()
    app.baseClient.connectionPool.evictAll()
    println("MULTISOURCE $count PASS; deterministic fixture tests; live service and Android device NOT_TESTED")
}
